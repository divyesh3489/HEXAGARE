# Copy to .env before the first run and set a real DJANGO_SECRET_KEY.
# Under Docker Compose these values are injected into every backend/celery container.

# --- Django ---
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-to-a-real-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# --- Datastores ---
DATABASE_URL=postgres://hexagare:hexagare@postgres:5432/hexagare
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ---
# Optional overrides; defaults are 60 min access / 1 day refresh.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1

# --- Email ---
# Leave DJANGO_EMAIL_BACKEND unset to print emails to the container logs.
# For real SMTP, set it to the line below and fill EMAIL_HOST_USER/PASSWORD.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@hexagare.local
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# --- Frontend links ---
# Base URL of the SPA, used in password-reset emails.
FRONTEND_BASE_URL=http://localhost:5173
# Host port the frontend dev server is published on.
FRONTEND_PORT=5173

# --- Object storage (S3 used only when USE_S3=true, i.e. staging/production) ---
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# --- Hexagare domain config (SKU / serial-number formatting) ---
HEXAGARE_SKU_PREFIX=HEX
HEXAGARE_SERIAL_PREFIX=HX
HEXAGARE_SERIAL_PADDING=6
HEXAGARE_INVOICE_PREFIX=HEX-INV
HEXAGARE_INVOICE_PADDING=6
