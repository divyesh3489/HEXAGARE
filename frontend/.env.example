# Copy to .env.local for host development. Under Docker Compose these are set
# by the frontend service in docker-compose.yml.

# Where the fetch client sends API requests (proxied to the backend by Vite).
VITE_API_BASE_URL=/api/v1

# Dev-server proxy target for /api (host: http://localhost:8000).
VITE_API_PROXY_TARGET=http://localhost:8000

# Dev server port.
FRONTEND_PORT=5173
